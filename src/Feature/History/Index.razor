@page "/"

<PageTitle>Universal Clipboard Bridge - E2EE 웹 대시보드</PageTitle>

<div class="orchid-web-shell">
    <GardenTopAppBar Height="16"
                     PaddingHorizontal="4"
                     PaddingVertical="1">
        <LeadingContent>
            <MudIcon Icon="@Icons.Material.Filled.ContentPasteGo"
                     Style="margin-right: var(--gdn-sys-spacing-2);" />
            <GardenTypography HtmlTag="h1"
                              Typo="TypographyStyle.Title"
                              Size="TypographySize.Large"
                              Style="margin-right: var(--gdn-sys-spacing-4); font-weight: 600; white-space: nowrap;">
                Universal Clipboard Bridge
            </GardenTypography>
        </LeadingContent>
        <HeadlineContent>
            <div style="max-width: 360px; width: 100%;">
                <GardenSearch T="string"
                              Placeholder="클립보드 내역 검색..."
                              TextChanged="OnSearchTextChanged" />
            </div>
        </HeadlineContent>
        <TrailingContent>
            <div style="display: flex; align-items: center; gap: 12px;">
                <GardenChipAssist Icon="@Icons.Material.Filled.Lock"
                                  Label="Zero-Knowledge E2EE"
                                  Variant="GardenChipAssistVariant.Outlined" />
                <GardenAccountMenu DisplayName="Orchid Web"
                                   Email="e2ee@botanicsoft.com"
                                   SignOutLabel="로그아웃" />
            </div>
        </TrailingContent>
    </GardenTopAppBar>

    <main style="max-width: 1120px; margin: 24px auto; padding: 0 16px; display: flex; flex-direction: column; gap: 16px;">
        <GardenCard Type="GardenCardType.Elevated" Style="padding: 24px; display: flex; flex-direction: column; gap: 8px;">
            <GardenTypography HtmlTag="h2" Typo="TypographyStyle.Headline" Size="TypographySize.Small">
                Orchid 클립보드 뷰어
            </GardenTypography>
            <GardenTypography Typo="TypographyStyle.Body" Size="TypographySize.Medium">
                Zero-Knowledge E2EE 클립보드 동기화 대시보드
            </GardenTypography>
        </GardenCard>

        <VirtualizedHistoryGrid Items="@FilteredItems" />
    </main>
</div>

@code {
    private List<ClipboardItem> sampleItems = [];
    private string searchQuery = string.Empty;

    private ICollection<ClipboardItem> FilteredItems =>
        string.IsNullOrWhiteSpace(searchQuery)
            ? sampleItems
            : sampleItems
                .Where(item => item.ContentType.ToString().Contains(searchQuery, StringComparison.OrdinalIgnoreCase))
                .ToList();

    protected override void OnInitialized()
    {
        sampleItems =
        [
            new ClipboardItem(
                Guid.NewGuid(),
                Guid.NewGuid(),
                DevicePlatform.Web,
                ContentType.Text,
                [1, 2, 3, 4],
                [5, 6, 7],
                [8, 9],
                "hash-1234",
                DateTimeOffset.UtcNow)
        ];
    }

    private void OnSearchTextChanged(string text)
    {
        searchQuery = text ?? string.Empty;
    }
}
