@namespace Orchid.Web.Component

<GardenCard Type="GardenCardType.Outlined" Style="padding: 8px;">
    <GardenTable T="ClipboardItem"
                 Items="@Items"
                 Hover="true"
                 Loading="@(Items == null)"
                 Breakpoint="Breakpoint.Sm">
        <HeaderContent>
            <MudTh>타입</MudTh>
            <MudTh>시간</MudTh>
            <MudTh>상태</MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="타입">
                <GardenChipAssist Label="@context.ContentType.ToString()"
                                  Variant="GardenChipAssistVariant.Elevated" />
            </MudTd>
            <MudTd DataLabel="시간">
                <GardenTypography Typo="TypographyStyle.Body" Size="TypographySize.Medium">
                    @context.CreatedAtUtc.ToLocalTime().ToString("yyyy-MM-dd HH:mm:ss")
                </GardenTypography>
            </MudTd>
            <MudTd DataLabel="상태">
                <GardenTypography Typo="TypographyStyle.Body" Size="TypographySize.Small">
                    E2EE 암호화됨 (@context.CipherText.Length bytes)
                </GardenTypography>
            </MudTd>
        </RowTemplate>
    </GardenTable>
</GardenCard>

@code {
    /// <summary>
    /// 가상화 목록에 표시할 클립보드 엔티티 컬렉션입니다.
    /// </summary>
    [Parameter]
    public ICollection<ClipboardItem> Items { get; set; } = [];
}
