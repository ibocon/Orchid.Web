@inject DesignSystem DesignSystem
@implements IDisposable

<OrchidWebDesignSystemProvider @ref="_provider" />
<MudThemeProvider Theme="_provider?.CurrentMudTheme" IsDarkMode="@(_provider?.IsDarkMode ?? false)" />
<MudDialogProvider />
<GardenSnackbarProvider />
<MudPopoverProvider />

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView>
            <GardenCard Type="GardenCardType.Outlined" Style="margin: 24px; padding: 24px;">
                <GardenTypography Typo="TypographyStyle.Title" Size="TypographySize.Medium">
                    페이지를 찾을 수 없습니다.
                </GardenTypography>
            </GardenCard>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private OrchidWebDesignSystemProvider? _provider;

    protected override void OnInitialized()
    {
        DesignSystem.Color.SchemeSet.ContextChanged += OnSchemeContextChanged;
    }

    private void OnSchemeContextChanged(object? sender, SchemeContextChangedEventArgs e)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        DesignSystem.Color.SchemeSet.ContextChanged -= OnSchemeContextChanged;
    }
}
