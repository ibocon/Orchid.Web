<OrchidWebDesignSystemProvider @ref="_provider" />
<MudThemeProvider Theme="_provider?.CurrentMudTheme" IsDarkMode="true" />
<MudDialogProvider />
<GardenSnackbarProvider />
<MudPopoverProvider />

<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <RouteView RouteData="@routeData" />
        <FocusOnNavigate RouteData="@routeData" Selector="h1" />
    </Found>
    <NotFound>
        <LayoutView>
            <GardenCard Type="GardenCardType.Outlined" Style="margin: 24px; padding: 24px;">
                <GardenTypography Typo="TypographyStyle.Title" Size="TypographySize.Medium">
                    페이지를 찾을 수 없습니다.
                </GardenTypography>
            </GardenCard>
        </LayoutView>
    </NotFound>
</Router>

@code {
    private OrchidWebDesignSystemProvider? _provider;
}
